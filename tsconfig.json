{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "removeComments": false,
    "experimentalDecorators": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "build",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}